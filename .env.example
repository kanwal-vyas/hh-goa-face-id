# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file — it is already listed in .gitignore.

# --- Blockchain ---

# Which BlockchainProvider to use: "local" or "testnet".
# "local" uses a pre-funded dev account on a local dev chain and does
# NOT require BLOCKCHAIN_PRIVATE_KEY. "testnet" requires a funded key.
BLOCKCHAIN_MODE=local

# RPC endpoint for the chosen blockchain mode.
# Local dev chain default (e.g. Hardhat/Anvil/Ganache):
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Required ONLY when BLOCKCHAIN_MODE=testnet.
# A funded testnet private key. NEVER use a mainnet key here.
# Leave blank for local mode (a Hardhat/Anvil-style local dev node
# provides its own pre-funded, unlocked account — no key needed).
BLOCKCHAIN_PRIVATE_KEY=

# Optional. Address of an already-deployed FingerprintRegistry contract.
# If left blank, LocalBlockchainProvider deploys a fresh contract
# automatically the first time it's needed and reuses it for the rest
# of that process's run. Set this to reuse the SAME deployed contract
# across separate CLI invocations (e.g. after noting the address logged
# on first deploy).
BLOCKCHAIN_CONTRACT_ADDRESS=

# --- Matching ---

# Face similarity threshold in [0.0, 1.0] used by candidate matching to
# decide NO_MATCH / POSSIBLE_MATCH / STRONG_MATCH bands. This threshold
# is a documented heuristic for the classical (non-deep-learned) LBP
# embedding used by default — tune it against your own authorized test
# images before relying on it for a demo.
MATCH_THRESHOLD=0.6

# --- Logging ---

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
